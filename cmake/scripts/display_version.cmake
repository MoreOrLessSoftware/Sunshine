# Writes the version Sunshine shows, run in script mode on every build so it never goes stale:
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<file.cpp> [-DFIXED_VERSION=<version>] -P display_version.cmake
#
# FIXED_VERSION, when set (CI builds), is shown as is. Otherwise the version is the git tag HEAD is
# exactly on, or else when it was built, as YYYY.MM.DD.hhmm. The output is only rewritten when the
# version changes, so it only recompiles then.

if(NOT "${FIXED_VERSION}" STREQUAL "")
    set(DISPLAY_VERSION "${FIXED_VERSION}")
else()
    find_package(Git QUIET)
    if(GIT_EXECUTABLE)
        execute_process(
                COMMAND ${GIT_EXECUTABLE} -C "${SOURCE_DIR}" describe --tags --exact-match
                OUTPUT_VARIABLE GIT_TAG
                RESULT_VARIABLE GIT_TAG_ERROR_CODE
                OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET
        )
    endif()

    if(GIT_EXECUTABLE AND NOT GIT_TAG_ERROR_CODE AND NOT "${GIT_TAG}" STREQUAL "")
        set(DISPLAY_VERSION "${GIT_TAG}")
    else()
        string(TIMESTAMP DISPLAY_VERSION "%Y.%m.%d.%H%M")
    endif()
endif()

set(CONTENT "// Generated by cmake/scripts/display_version.cmake on every build. Do not edit.
#include \"src/display_version.h\"

std::string_view display_version() {
  return \"${DISPLAY_VERSION}\";
}
")

if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" EXISTING)
endif()
if(NOT "${EXISTING}" STREQUAL "${CONTENT}")
    file(WRITE "${OUTPUT}" "${CONTENT}")
endif()
